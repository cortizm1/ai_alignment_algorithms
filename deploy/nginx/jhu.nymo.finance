# /etc/nginx/sites-available/jhu.nymo.finance — TLS termination -> Anubis -> backend (:8010)
server {
  listen 80; listen [::]:80;
  server_name jhu.nymo.finance;
  location /.well-known/acme-challenge/ { root /var/www/html; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl http2; listen [::]:443 ssl http2;
  server_name jhu.nymo.finance;
  ssl_certificate     /etc/letsencrypt/live/jhu.nymo.finance/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/jhu.nymo.finance/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d; ssl_session_cache shared:SSL:10m; ssl_session_tickets off;
  add_header Strict-Transport-Security "max-age=31536000" always;
  location / {
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Http-Version $server_protocol;
    proxy_set_header X-TLS-SNI-Name $ssl_server_name;
    proxy_pass http://anubis;
  }
}
